Visualization Manager:
  Class: ""
  Displays:
    # =====================================================================
    # GLOBAL SETTINGS
    # =====================================================================
    # Reference frame for all visualizations
    # =====================================================================
    - Alpha: 0.2
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 30
      Name: Axes
      Radius: 0.8
      Reference Frame: <Fixed Frame>
      Value: true

    # =====================================================================
    # ENVIRONMENT - Grid and Reference
    # =====================================================================
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: world
      Value: true

    # =====================================================================
    # TARGET - Perching Target Platform
    # =====================================================================
    - Angle Tolerance: 0.01
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 1
      Name: Target Platform
      Position Tolerance: 0.01
      Queue Size: 10
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.1
        Color: 255; 25; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1
        Shaft Radius: 0.05
        Value: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone0/target_odom
      Unreliable: false
      Value: true

    # =====================================================================
    # ROBOT - Drone Visualization
    # =====================================================================
    # Robot Model (Mesh)
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot Model
      Queue Size: 100
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone0/robot
      Value: true

    # =====================================================================
    # PLATFORM - Landing Platform Visualization
    # =====================================================================
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Landing Platform
      Queue Size: 100
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone0/polygon
      Value: true

    # =====================================================================
    # TAIL VELOCITY - Terminal Velocity Arrow
    # =====================================================================
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Tail Velocity
      Queue Size: 100
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone0/tail_vel
      Value: true

    # =====================================================================
    # TRAJECTORY - Planned Path Visualization
    # =====================================================================
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 0; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.05
      Name: Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Queue Size: 10
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone0/traj
      Unreliable: false
      Value: true

    # =====================================================================
    # WAYPOINTS - Trajectory Control Points
    # =====================================================================
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Waypoints
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.15
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone0/traj_wayPts
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root

  # =====================================================================
  # TOOLS - Interaction Tools
  # =====================================================================
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point

  Value: true

  # =====================================================================
  # VIEW - Camera Settings
  # =====================================================================
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Distance: 10.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785
      Focal Point:
        X: 3.0
        Y: 0.0
        Z: 1.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.25
      Target Frame: world
      Yaw: 0.0
    Saved: ~

  # =====================================================================
  # WINDOW GEOMETRY
  # =====================================================================
  Window Geometry:
    Height: 800
    Width: 1200
    X: 100
    Y: 100